# Backend production environment
ConnectionStrings__DefaultConnection=
Jwt__Key=
Jwt__Issuer=SilverlandCRM
Jwt__Audience=SilverlandCRM
Cors__AllowedOrigins=https://silverland-crm.onrender.com
ASPNETCORE_ENVIRONMENT=Production

# Frontend build-time environment
VITE_API_URL=https://silverland-crm-api.onrender.com

# Database Credentials
POSTGRES_DB=silverland_crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=silverland_crm_db;Username=postgres;Password=your_secure_password;SSL Mode=Prefer;

# Security Secrets
Jwt__Secret=YOUR_VERY_LONG_SUPER_SECRET_KEY_MIN_32_CHARS!
Jwt__Issuer=SilverlandCRM
Jwt__Audience=SilverlandClients
Jwt__ExpirationMinutes=480

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins=http://localhost:5173,https://silverland-crm.onrender.com
VITE_API_URL=http://localhost:8080/api
